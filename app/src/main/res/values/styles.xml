<resources>
    <!-- Define a style for making the ImageView round -->
    <style name="CircularShape">
        <item name="cornerFamily">rounded</item> <!-- Use rounded corners -->
        <item name="cornerSize">50%</item> <!-- Make the corners 50% to make it circular -->
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>


    <style name="GraphTab">
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>
